    <string id="DemoTitleEn">Demo</string>
    <string id="DemoFallEn">Simulate fall</string>
    <string id="DemoHighHeartRateEn">High heart rate</string>
    <string id="DemoCriticalHeartRateEn">Critical heart rate</string>
