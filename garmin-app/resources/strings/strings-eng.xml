    <string id="LanguageTitleEn">Language</string>
    <string id="LanguageCurrentEn">Current</string>
    <string id="LanguageEsNameEn">Español</string>
    <string id="LanguageEnNameEn">English</string>
    <!-- Prompt sent to Gemini. Never shown on screen. -->
    <string id="GeminiPromptEn">You are the assistant of ElderGuard AI, a safety watch for older adults. Write the message an emergency contact of the person wearing the watch will receive. Event: $1$. Heart rate: $2$ BPM. Time: $3$. Location: $4$. At most 2 sentences and 160 characters, in English, clear and calm. Do not use brackets, placeholders, links or made-up details. Reply with the message only.</string>
    <string id="GeminiEventFallEn">confirmed fall; the person did not answer the countdown</string>
    <string id="GeminiEventManualSosEn">the person pressed the SOS button to ask for help</string>
    <string id="GeminiEventHighHeartRateEn">sustained critical heart rate at rest</string>
    <string id="GeminiLocationGpsEn">$1$, $2$ (GPS)</string>
    <string id="GeminiLocationLastEn">last known position $1$, $2$ (no GPS signal)</string>
    <!-- Static text of an alert, sent when Gemini does not answer in time. -->
    <string id="AlertTemplateFallEn">ElderGuard AI: a fall was detected and the person did not respond. Heart rate: $1$ BPM. Location: $2$.</string>
    <string id="AlertTemplateManualSosEn">ElderGuard AI: the person asked for help with the SOS button. Heart rate: $1$ BPM. Location: $2$.</string>
    <string id="AlertTemplateHighHeartRateEn">ElderGuard AI: critical heart rate of $1$ BPM at rest. Location: $2$.</string>
</strings>
