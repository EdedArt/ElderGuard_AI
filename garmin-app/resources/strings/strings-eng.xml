<?xml version="1.0" encoding="UTF-8"?>
<!--
    English, chosen by the user in the app. Each id is the Spanish id in strings.xml plus "En".
    A default resource like strings.xml, so it is available whatever the language of the watch.
-->
<strings>
    <!-- Clock and short date ("Sun, Nov 8"). -->
    <string id="ClockAmEn">AM</string>
    <string id="ClockPmEn">PM</string>
    <string id="DateFormatEn">$1$, $3$ $2$</string>
    <string id="WeekdaysShortEn">Sun,Mon,Tue,Wed,Thu,Fri,Sat</string>
    <string id="MonthsShortEn">Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec</string>
    <!-- Watchface status and data. -->
    <string id="HeartRateUnitEn">BPM</string>
    <string id="BatteryValueEn">$1$%</string>
    <string id="GpsOkEn">GPS</string>
    <string id="GpsLostEn">No GPS</string>
    <!-- Heart rate warning banner. -->
    <string id="HeartRateAlertHighEn">High heart rate at rest</string>
    <string id="HeartRateAlertCriticalEn">Critical pulse: family notified</string>
    <!-- SOS button. -->
    <string id="SosTitleEn">SOS</string>
    <string id="SosLabelEn">HELP</string>
    <string id="SosHoldHintEn">Hold to call for help</string>
    <!-- SOS active screen. -->
    <string id="SosActiveEn">Calling for help…</string>
    <string id="SosCancelEn">Cancel</string>
    <string id="SosNotifiedEn">Notified (mock)</string>
    <string id="SosLocationEn">GPS</string>
    <string id="SosLastLocationEn">Last position</string>
    <string id="SosCoordinatesEn">$1$, $2$</string>
    <!-- Fall countdown screen. -->
    <string id="FallQuestionEn">Did you fall?</string>
    <string id="FallCancelEn">I'M OK</string>
    <!-- Language screen. -->
    <string id="LanguageTitleEn">Language</string>
    <string id="LanguageCurrentEn">Current</string>
    <string id="LanguageEsNameEn">Español</string>
    <string id="LanguageEnNameEn">English</string>
</strings>
