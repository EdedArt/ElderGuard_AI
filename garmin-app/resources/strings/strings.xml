<?xml version="1.0" encoding="UTF-8"?>
<!--
    Spanish, the default language of the app. Every string here has an English version in
    strings-eng.xml with the same id plus "En". Both files are default resources: the app chooses
    between them with LanguagePreference.text(), not by the language of the watch.
-->
<strings>
    <!-- Name in the watch's app list, shown by the system. The same in both languages. -->
    <string id="AppName">ElderGuard AI</string>
    <!-- Clock: 12-hour period labels, as in the web and Wear OS apps. -->
    <string id="ClockAm">a. m.</string>
    <string id="ClockPm">p. m.</string>
    <!-- Short date, as Intl.DateTimeFormat writes it ("dom, 8 nov"): $1$ weekday, $2$ day,
         $3$ month. The names are comma-separated lists, Sunday and January first. -->
    <string id="DateFormat">$1$, $2$ $3$</string>
    <string id="WeekdaysShort">dom,lun,mar,mié,jue,vie,sáb</string>
    <string id="MonthsShort">ene,feb,mar,abr,may,jun,jul,ago,sept,oct,nov,dic</string>
    <!-- Watchface status and data. -->
    <string id="HeartRateUnit">LPM</string>
    <string id="BatteryValue">$1$ %</string>
    <string id="GpsOk">GPS</string>
    <string id="GpsLost">Sin GPS</string>
    <!-- Heart rate warning banner. Shorter than in the other apps ("Ritmo cardíaco alto en
         reposo"), which does not fit the width of the round screen at its row. -->
    <string id="HeartRateAlertHigh">Pulso alto en reposo</string>
    <!-- Same banner, red, when the rate is critical and the family was told (mock). -->
    <string id="HeartRateAlertCritical">Pulso crítico: familia avisada</string>
    <!-- SOS button. -->
    <string id="SosTitle">SOS</string>
    <string id="SosLabel">AUXILIO</string>
    <string id="SosHoldHint">Mantén presionado</string>
    <!-- SOS active screen. -->
    <string id="SosActive">Pidiendo ayuda…</string>
    <string id="SosCancel">Cancelar</string>
    <!-- Confirmation of the (mock) alert on the SOS screen: who was told and where the alert
         says the person is. The coordinates go on a line of their own: with the label they do
         not fit the round screen. -->
    <string id="SosNotified">Avisados (simulado)</string>
    <string id="SosLocation">GPS</string>
    <string id="SosLastLocation">Última posición</string>
    <string id="SosCoordinates">$1$, $2$</string>
    <!-- Fall countdown screen. -->
    <string id="FallQuestion">¿Te caíste?</string>
    <string id="FallCancel">ESTOY BIEN</string>
    <!-- Main menu (hold UP): the language screen and the demo screen. -->
    <string id="MenuTitle">Menú</string>
    <string id="MenuLanguage">Idioma</string>
    <string id="MenuDemo">Demostración</string>
    <!-- Demo screen: each item runs a simulated scenario. -->
    <string id="DemoTitle">Demostración</string>
    <string id="DemoFall">Simular caída</string>
    <string id="DemoHighHeartRate">Pulso alto</string>
    <string id="DemoCriticalHeartRate">Pulso crítico</string>
    <string id="DemoLowBattery">Batería baja</string>
    <string id="DemoGpsLost">Sin GPS</string>
    <string id="DemoReset">Restablecer</string>
    <!-- Language screen. Each language is named in itself, so someone who switched by mistake
         still finds theirs; the names are the same in both files. -->
    <string id="LanguageTitle">Idioma</string>
    <string id="LanguageCurrent">Actual</string>
    <string id="LanguageEsName">Español</string>
    <string id="LanguageEnName">English</string>
    <!-- Prompt sent to Gemini to write the text of an alert. Never shown on screen.
         $1$ the event, $2$ heart rate in BPM, $3$ time (24-hour), $4$ location. -->
    <string id="GeminiPrompt">Eres el asistente de ElderGuard AI, un reloj de seguridad para personas mayores. Escribe el mensaje que recibirá un contacto de emergencia de la persona que lleva el reloj. Evento: $1$. Pulso: $2$ LPM. Hora: $3$. Ubicación: $4$. Máximo 2 frases y 160 caracteres, en español, claro y calmado. No uses corchetes, marcadores, enlaces ni datos inventados. Responde solo con el mensaje.</string>
    <string id="GeminiEventFall">caída confirmada; la persona no respondió a la cuenta regresiva</string>
    <string id="GeminiEventManualSos">la persona pulsó el botón SOS para pedir ayuda</string>
    <string id="GeminiEventHighHeartRate">pulso crítico sostenido en reposo</string>
    <string id="GeminiLocationGps">$1$, $2$ (GPS)</string>
    <string id="GeminiLocationLast">última posición conocida $1$, $2$ (sin señal GPS)</string>
    <!-- Static text of an alert, sent when Gemini does not answer in time. $1$ heart rate in BPM,
         $2$ location (GeminiLocationGps or GeminiLocationLast). -->
    <string id="AlertTemplateFall">ElderGuard AI: se detectó una caída y la persona no respondió. Pulso: $1$ LPM. Ubicación: $2$.</string>
    <string id="AlertTemplateManualSos">ElderGuard AI: la persona pidió ayuda con el botón SOS. Pulso: $1$ LPM. Ubicación: $2$.</string>
    <string id="AlertTemplateHighHeartRate">ElderGuard AI: pulso crítico de $1$ LPM en reposo. Ubicación: $2$.</string>
</strings>
