<?xml version="1.0" encoding="UTF-8"?>
<!--
    Spanish, the default language of the app. Every string here has an English version in
    strings-eng.xml with the same id plus "En". Both files are default resources: the app chooses
    between them with LanguagePreference.text(), not by the language of the watch.
-->
<strings>
    <!-- Name in the watch's app list, shown by the system. The same in both languages. -->
    <string id="AppName">ElderGuard AI</string>
    <!-- Temporary live readout, replaced by the watchface in a later phase.
         $1$ is replaced by the value (Lang.format). -->
    <string id="ReadoutHeartRate">$1$ LPM</string>
    <string id="ReadoutBattery">Batería $1$ %</string>
    <string id="ReadoutMovement">Movimiento $1$ g</string>
    <!-- Decimal separator for numbers shown on screen. -->
    <string id="DecimalSeparator">,</string>
    <!-- Clock: 12-hour period labels, as in the web and Wear OS apps. -->
    <string id="ClockAm">a. m.</string>
    <string id="ClockPm">p. m.</string>
    <!-- Short date, as Intl.DateTimeFormat writes it ("dom, 8 nov"): $1$ weekday, $2$ day,
         $3$ month. The names are comma-separated lists, Sunday and January first. -->
    <string id="DateFormat">$1$, $2$ $3$</string>
    <string id="WeekdaysShort">dom,lun,mar,mié,jue,vie,sáb</string>
    <string id="MonthsShort">ene,feb,mar,abr,may,jun,jul,ago,sept,oct,nov,dic</string>
    <!-- Watchface status and data. -->
    <string id="HeartRateUnit">LPM</string>
    <string id="BatteryValue">$1$ %</string>
    <string id="GpsOk">GPS</string>
    <string id="GpsLost">Sin GPS</string>
    <!-- SOS button. -->
    <string id="SosTitle">SOS</string>
    <string id="SosLabel">AUXILIO</string>
    <string id="SosHoldHint">Mantén presionado</string>
    <!-- SOS active screen. -->
    <string id="SosActive">Pidiendo ayuda…</string>
    <string id="SosCancel">Cancelar</string>
    <!-- Language screen. Each language is named in itself, so someone who switched by mistake
         still finds theirs; the names are the same in both files. -->
    <string id="LanguageTitle">Idioma</string>
    <string id="LanguageCurrent">Actual</string>
    <string id="LanguageEsName">Español</string>
    <string id="LanguageEnName">English</string>
</strings>
