<?xml version="1.0" encoding="UTF-8"?>
<!--
    Connect IQ manifest for ElderGuard AI on the Garmin Forerunner 165.
    Verified against Connect IQ SDK 9.3.0 (bin/templates/watch-app and bin/projectInfo.xml).

    - id: a locally generated UUID (32 hex characters, no dashes), the same format that
      "Monkey C: Regenerate UUID" produces. Sideloading does not need a store-issued ID, but
      the ID must never change, or the watch treats a new build as a different app.
    - minApiLevel: 5.2.0, the API level the SDK lists for the fr165
      (Devices/fr165/compiler.json: "deviceGroup": "API level 5.2").
-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application
        id="317979134c5a4f49a94bb7f7ee876bcd"
        type="watch-app"
        name="@Strings.AppName"
        entry="ElderGuardApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="5.2.0">

        <!-- Forerunner 165: 390x390 round AMOLED touchscreen. -->
        <iq:products>
            <iq:product id="fr165"/>
        </iq:products>

        <!-- None needed yet. Telemetry will need "Sensor" (heart rate, accelerometer) and
             "Positioning" (GPS) in later phases. -->
        <iq:permissions/>

        <!-- Spanish is the default; English is the alternative, as in the other implementations. -->
        <iq:languages>
            <iq:language>spa</iq:language>
            <iq:language>eng</iq:language>
        </iq:languages>

        <iq:barrels/>
    </iq:application>
</iq:manifest>
