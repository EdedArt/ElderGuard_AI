<?xml version="1.0" encoding="UTF-8"?>
<!--
    Connect IQ manifest for ElderGuard AI on the Garmin Forerunner 165.

    PLACEHOLDERS to replace once the Connect IQ SDK and a Garmin developer account are set up:
    - id: a fake application ID. Generate the real one in VS Code with
      "Monkey C: Regenerate UUID" (or let the new-project wizard create it). It must be a unique
      32-character hexadecimal UUID without dashes.
    - minApiLevel: a conservative guess. Check the API level the fr165 supports in the SDK
      Manager's device list and adjust.
-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application
        id="00000000000000000000000000000000"
        type="watch-app"
        name="@Strings.AppName"
        entry="ElderGuardApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.2.0">

        <!-- Forerunner 165: 390x390 round AMOLED touchscreen. -->
        <iq:products>
            <iq:product id="fr165"/>
        </iq:products>

        <!-- None needed yet. Telemetry will need "Sensor" (heart rate, accelerometer) and
             "Positioning" (GPS) in later phases. -->
        <iq:permissions/>

        <!-- Spanish is the default; English is the alternative, as in the other implementations. -->
        <iq:languages>
            <iq:language>spa</iq:language>
            <iq:language>eng</iq:language>
        </iq:languages>

        <iq:barrels/>
    </iq:application>
</iq:manifest>
