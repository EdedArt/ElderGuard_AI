# Dependencies
node_modules/

# Build output
dist/

# Native Wear OS app (Gradle and Android Studio output)
wear-app/**/build/
wear-app/.gradle/
wear-app/.kotlin/
wear-app/local.properties
wear-app/**/*.apk
wear-app/**/*.aab
wear-app/**/*.iml

# Garmin Connect IQ app (compiler output and the private developer signing key)
garmin-app/bin/
garmin-app/**/*.prg
garmin-app/**/*.iq
garmin-app/**/*.der
garmin-app/**/*.pem
garmin-app/**/developer_key*

# Environment files
.env
.env.*
!.env.example

# Logs
*.log

# Editor files (only recommended extensions are shared)
.vscode/*
!.vscode/extensions.json
.idea/

# OS files
.DS_Store
Thumbs.db
Desktop.ini
*.der
